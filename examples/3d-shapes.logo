; 3D Shapes Example
; Demonstrates 3D primitives and ZCOR queries

CLEAR
HOME

PRINT [Creating 3D shapes...]

; Create a sphere
SETXYZ -100 0 0
MAKE "s1 SPHERE 30
PRINT [Sphere at:] XCOR YCOR ZCOR

; Create a cube
SETXYZ 0 0 0
MAKE "c1 CUBE 40
PRINT [Cube at:] XCOR YCOR ZCOR

; Create a cylinder
SETXYZ 100 0 0
MAKE "cyl CYLINDER 20 60
PRINT [Cylinder at:] XCOR YCOR ZCOR

; Create a tower by stacking shapes vertically
HOME
SETXYZ 0 100 0

REPEAT 5 [
    ; Create a cube at current Z height
    MAKE "tower CUBE 30
    PRINT [Tower level] REPCOUNT [at Z:] ZCOR

    ; Move up for next level
    SETZ (ZCOR + 35)
]

PRINT [
PRINT [3D shapes demo complete!]
PRINT [Use mouse to rotate the view]
PRINT [Click Export STL to save as 3D model]
