; 3D House using BEGINFACE/ENDFACE
; Build a complete 3D house with walls, roof, door, and windows
; Three.js coordinates: X=red (left/right), Y=green (up/down), Z=blue (forward/back)

CLEAR
HOME

PRINT "Building a 3D house with BEGINFACE/ENDFACE..."

; ======================================
; Helper procedure to create a vertical rectangle face
; Assumes turtle is already positioned and oriented
; ======================================
TO VRECTFACE :width :height
    BEGINFACE
    PENDOWN
    FORWARD :height
    LEFT 90
    FORWARD :width
    LEFT 90
    FORWARD :height
    LEFT 90
    FORWARD :width
    ENDFACE
END

; ======================================
; 1. Build the Floor (horizontal rectangle in XZ plane)
; ======================================
PRINT "Building floor..."
SETPENRGB 100 100 100  ; Gray floor
SETXYZ 0 0 0
SETHEADING 0
PENDOWN
BEGINFACE
FORWARD 200
LEFT 90
FORWARD 200
LEFT 90
FORWARD 200
LEFT 90
FORWARD 200
ENDFACE

; ======================================
; 2. Build Four Walls
; ======================================
PRINT "Building walls..."
SETPENRGB 200 150 100  ; Tan walls

; Front wall (facing -Z, in XY plane at Z=-100)
SETXYZ -100 0 -100
SETHEADING 90  ; Facing +X (right)
UP 90  ; Now facing +Y (up)
VRECTFACE 200 150

; Back wall (facing +Z, in XY plane at Z=100)
SETXYZ -100 0 100
SETHEADING 90  ; Facing +X (right)
DOWN 90  ; Now facing -Y (down), so we draw upward correctly
DOWN 90  ; Actually facing -Z now... let me reconsider
; Better approach: position and orient explicitly
SETXYZ -100 0 100
SETHEADING 90
UP 90
VRECTFACE 200 150

; Left wall (facing -X, in YZ plane at X=-100)
SETXYZ -100 0 -100
SETHEADING 0  ; Facing -Z (forward)
UP 90  ; Now facing +Y (up)
VRECTFACE 200 150

; Right wall (facing +X, in YZ plane at X=100)
SETXYZ 100 0 -100
SETHEADING 180  ; Facing +Z (back)
UP 90  ; Now facing +Y (up)
VRECTFACE 200 150

; ======================================
; 3. Add Door (on right wall)
; ======================================
PRINT "Adding door..."
SETPENRGB 80 40 20  ; Brown door
SETXYZ 101 0 -30  ; Slightly outside right wall, centered
SETHEADING 180
UP 90
BEGINFACE
PENDOWN
FORWARD 80
LEFT 90
FORWARD 60
LEFT 90
FORWARD 80
LEFT 90
FORWARD 60
ENDFACE

; ======================================
; 4. Add Windows
; ======================================
PRINT "Adding windows..."
SETPENRGB 150 200 255  ; Light blue glass

; Front wall window (left)
SETXYZ -60 90 -101
SETHEADING 90
UP 90
BEGINFACE
PENDOWN
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
ENDFACE

; Front wall window (right)
SETXYZ 20 90 -101
SETHEADING 90
UP 90
BEGINFACE
PENDOWN
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
ENDFACE

; Left wall window
SETXYZ -101 90 -20
SETHEADING 0
UP 90
BEGINFACE
PENDOWN
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
LEFT 90
FORWARD 40
ENDFACE

; ======================================
; 5. Build Roof (simple peaked roof)
; ======================================
PRINT "Building roof..."
SETPENRGB 150 50 50  ; Dark red roof

; Front triangular gable (at Z=-100)
SETXYZ -100 150 -100
SETHEADING 90  ; Facing +X
UP 90  ; Facing +Y (up)
BEGINFACE
PENDOWN
FORWARD 200  ; Across the width
LEFT 135
FORWARD 141.4  ; Diagonal to peak (100 * sqrt(2))
LEFT 90
FORWARD 141.4  ; Back down
ENDFACE

; Back triangular gable (at Z=100)
SETXYZ -100 150 100
SETHEADING 90
UP 90
BEGINFACE
PENDOWN
FORWARD 200
LEFT 135
FORWARD 141.4
LEFT 90
FORWARD 141.4
ENDFACE

; Left roof slope
SETPENRGB 180 60 60  ; Lighter red
SETXYZ -100 150 -100
SETHEADING 0  ; Facing -Z (forward)
LEFT 45  ; Rotate to face the slope direction
UP 45  ; Pitch up to match roof angle
BEGINFACE
PENDOWN
FORWARD 200  ; Along the Z axis
LEFT 90
FORWARD 141.4  ; Sloped length
LEFT 90
FORWARD 200
LEFT 90
FORWARD 141.4
ENDFACE

; Right roof slope
SETXYZ 100 150 -100
SETHEADING 0
RIGHT 45
UP 45
BEGINFACE
PENDOWN
FORWARD 200
LEFT 90
FORWARD 141.4
LEFT 90
FORWARD 200
LEFT 90
FORWARD 141.4
ENDFACE

; ======================================
; Finished!
; ======================================
HOME
PRINT ""
PRINT "=== 3D House Complete! ==="
PRINT ""
PRINT ["Features:"]
PRINT ["- Floor and 4 walls"]
PRINT ["- Peaked roof with gables"]
PRINT ["- Door and 3 windows"]
PRINT ""
PRINT ["Use mouse to rotate view:"]
PRINT ["- Left drag: Rotate"]
PRINT ["- Right/Middle drag: Pan"]
PRINT ["- Wheel: Zoom"]
